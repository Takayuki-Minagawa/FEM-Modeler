{
  "name": "fem-modeler",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "ci": "npm run check && npm run audit && npm run build && npm run bundle:check",
    "test:e2e": "npm run build && playwright test",
    "test:performance": "FEM_PERFORMANCE=1 vitest run tests/performance",
    "test:solvers": "uv run --locked --project solver-tests/openfoam python solver-tests/run.py",
    "test:solvers:verify": "uv run --locked --project solver-tests/openfoam pytest solver-tests/test_results.py solver-tests/test_collector.py -q"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "i18next": "^26.4.2",
    "idb": "^8.0.3",
    "immer": "^11.1.4",
    "nanoid": "^6.0.1",
    "opencascade.js": "1.1.1",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-hotkeys-hook": "^5.2.4",
    "react-i18next": "^17.0.13",
    "react-resizable-panels": "^4.7.5",
    "three": "^0.186.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}
